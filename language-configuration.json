{
    "comments": {
        "lineComment": "#"
    },
    "brackets": [
        ["[", "]"],
        ["(", ")"]
    ],
    "autoClosingPairs": [
        { "open": "[", "close": "]" },
        { "open": "(", "close": ")" },
        { "open": "\"", "close": "\"", "notIn": ["string", "comment"] }
    ],
    "surroundingPairs": [
        ["[", "]"],
        ["(", ")"],
        ["\"", "\""]
    ],
    "wordPattern": "-?\\d*\\.\\d\\w*|[A-Za-z_][A-Za-z0-9_]*",
    "indentationRules": {
        "increaseIndentPattern": "^\\s*(if|elif|else|while|for|func)\\b(?!.*\\bend\\b\\s*(#.*)?$).*$",
        "decreaseIndentPattern": "^\\s*(end|else|elif)\\b"
    },
    "folding": {
        "offSide": false,
        "markers": {
            "start": "^\\s*(if|while|for|func)\\b(?!.*\\bend\\b\\s*(#.*)?$)",
            "end": "^\\s*end\\b"
        }
    }
}
